    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "require": {
        "ecotone/tempest": "~1.328.1",
        "ecotone/dbal": "~1.328.1",
        "ecotone/jms-converter": "~1.328.1",
        "tempest/framework": "^3.11",
        "ramsey/uuid": "^4.0"
